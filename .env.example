# =============================================================================
# 環境變數範本
# -----------------------------------------------------------------------------
# 使用方式：
#   1. 複製此檔為 .env（開發）或 .env.production（正式部署用，請勿提交至 Git）
#   2. 將下方所有 "replace-..." 佔位字串改為實際值
#   3. 切勿將含真實密鑰的檔案提交版本控制
#
# 密鑰生成指令：
#   openssl rand -base64 48
#
# 更詳細的部署說明見 README.md「Docker 部署」章節。
# =============================================================================

# -- 資料庫 -------------------------------------------------------------------
# PostgreSQL 連線字串。本地開發使用 docker-compose 時可直接連 localhost:5432。
# 正式環境請替換為實際 DB host／port／credentials。
DATABASE_URL="postgresql://postgres:password@localhost:5432/rollcall"

# -- NextAuth.js / Auth.js v5 -------------------------------------------------
# 應用程式對外網址，Auth.js 用來組裝 OAuth callback URL。
#   開發環境：http://localhost:3000
#   正式環境：https://你的網域（必須與 Google OAuth Authorized redirect URIs 一致）
NEXTAUTH_URL="http://localhost:3000"

# Session／JWT 簽章密鑰，至少 32 字元。請用 openssl rand -base64 48 產生。
NEXTAUTH_SECRET="replace-with-random-secret-at-least-32-chars"

# -- Google OAuth 2.0 ---------------------------------------------------------
# 取得方式：
#   1. 前往 https://console.cloud.google.com/apis/credentials
#   2. 建立 OAuth 2.0 Client ID（Application type: Web application）
#   3. Authorized JavaScript origins 加入：http://localhost:3000 與正式網域
#   4. Authorized redirect URIs 加入：
#        http://localhost:3000/api/auth/callback/google
#        https://你的網域/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# -- QR Code 簽章 -------------------------------------------------------------
# 用於點名 QR Code 的 HMAC 簽章，至少 32 字元。
# 請與 NEXTAUTH_SECRET 使用「不同」的隨機值，降低密鑰洩漏的橫向擴散風險。
QR_SECRET="replace-with-random-hmac-secret-at-least-32-chars"

# -- 管理員白名單 -------------------------------------------------------------
# 首次以這些 Email 登入的使用者會自動指派為管理員（admin）。
# 多個 Email 用逗號分隔，例如：admin@school.edu,dept@school.edu
ADMIN_EMAILS="admin@school.edu"

# -- Cloudflare Turnstile -----------------------------------------------------
# 登入頁面的機器人驗證。取得方式：
#   1. 前往 https://dash.cloudflare.com → Turnstile → Add Site
#   2. 將正式網域與 localhost 加入 Hostnames
#   3. 將 Site Key 填入 TURNSTILE_SITE_KEY、Secret Key 填入 TURNSTILE_SECRET_KEY
# 兩者皆留白時，登入頁面不會顯示驗證元件，伺服器端也會跳過驗證（適用本機開發）。
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -- IPinfo -------------------------------------------------------------------
# 用於將點名 IP 解析為國家資訊。未設定時會退回 Cloudflare CF-IPCountry 標頭。
IPINFO_TOKEN=""

# -- 時區 ---------------------------------------------------------------------
# 應用程式時區，影響稽核日誌時間戳與出席統計。專案統一為 Asia/Taipei。
TZ="Asia/Taipei"

# -- 點名同 IP 防分享 ---------------------------------------------------------
# 同一 Session 內，當某 IP 已替「N 位以上不同學生」簽到時，後續來自同 IP 的
# 點名請求回 429。預設 0 = 關閉（避免教室 Wi-Fi NAT 誤殺）。
# 若部署環境學生大多用行動數據（IP 通常不重疊），可改為 3~5 提升 QR 分享偵測。
MAX_ATTENDANCE_PER_IP_PER_SESSION="0"

# -- 信任 Proxy / 真實客戶端 IP ----------------------------------------------
# 決定如何從 HTTP 標頭推斷真實客戶端 IP（影響點名稽核、IP 封鎖規則）。
#   cloudflare（預設）：信任 Cloudflare 的 cf-connecting-ip / cf-ipcountry；
#                       缺漏時退回 x-forwarded-for 的最右側欄位。
#   forwarded：忽略 cf-* 標頭，只取 x-forwarded-for 最右側欄位
#              （適合 nginx／Caddy 等單一反向代理部署）。
#   none：不信任任何轉發標頭，IP 一律記為 null（適合直接暴露 origin 的小型部署）。
# 注意：若使用 cloudflare 模式，請務必在防火牆層強制 origin 僅接受 Cloudflare IP；
# 否則攻擊者可繞過 CF 直接送偽造的 cf-connecting-ip 來偽冒 IP。
TRUSTED_PROXY_MODE="cloudflare"

# -- 選填 ---------------------------------------------------------------------
# 反向代理後若仍出現 UntrustedHost 錯誤，可顯式啟用。
# 本專案已在 src/lib/auth.ts 設 trustHost: true，通常不需設定。
# AUTH_TRUST_HOST="true"
